datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

model Car {
  id                         String    @id @default(uuid()) @db.Uuid
  model                      String
  sub_model                  String?

  starting_price             Decimal?  @db.Decimal(12, 2)

  length_mm                  Int?
  width_mm                   Int?
  height_mm                  Int?
  wheelbase_mm               Int?

  seating_capacity           Int?
  trunk_volume_min_l         Int?
  trunk_volume_max_l         Int?
  curb_weight_min_kg         Int?
  curb_weight_max_kg         Int?

  battery_type               String?
  battery_capacity_kwh       Decimal?  @db.Decimal(6, 2)
  range_km                   Int?
  range_standard             String?

  ac_charging_kw             Decimal?  @db.Decimal(5, 1)
  dc_charging_kw             Decimal?  @db.Decimal(5, 1)
  max_dc_fast_charging_kw    Decimal?  @db.Decimal(5, 1)
  dc_fast_charging_30_80_min Int?

  v2l                        Boolean   @default(false)

  max_power_kw               Decimal?  @db.Decimal(6, 1)
  max_torque_nm              Decimal?  @db.Decimal(7, 1)
  acceleration_0_100_s       Decimal?  @db.Decimal(4, 1)

  drive_type                 String?
  drive_modes                String[]

  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime  @updatedAt @db.Timestamptz(6)

  appointments               Appointment[]

  @@map("cars")
}

model Appointment {
  id               String    @id @default(uuid()) @db.Uuid
  customer_name    String
  customer_email   String
  customer_phone   String

  car_id           String?   @db.Uuid
  vehicle_model    String?
  car              Car?      @relation(fields: [car_id], references: [id])

  service_type     String
  appointment_date DateTime  @db.Date
  appointment_time DateTime  @db.Time(6)
  notes            String?
  status           String    @default("Scheduled")

  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)

  @@map("appointments")
}
