# ===========================================
# TitanCare Project - Consolidated .gitignore
# ===========================================

# -----------------------------
# OS Files
# -----------------------------
.DS_Store
Thumbs.db
*~

# -----------------------------
# IDE / Editors
# -----------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# -----------------------------
# Environment Variables
# -----------------------------
.env
.env.local
.env.*.local
*.local

# -----------------------------
# Logs
# -----------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------
# Python (backend/)
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# -----------------------------
# Node.js (frontend/)
# -----------------------------
node_modules/
dist/
dist-ssr/

# -----------------------------
# Docker
# -----------------------------
*.pid
*.seed
*.pid.lock